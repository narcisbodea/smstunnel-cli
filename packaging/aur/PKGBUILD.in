# Maintainer: Narcis Bodea <contact at narboweb dot ro>
#
# The smstunnel command (SMSTunnel CLI), from the release archives on GitHub. Made by packaging/aur/update.sh
# from this template: run it rather than editing PKGBUILD and .SRCINFO by hand.
pkgname=smstunnel-cli-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Send texts from your computer through your own Android phone and number (SMSTunnel CLI)'
arch=('x86_64' 'aarch64')
url='https://smstunnel.io'
license=('MIT')
depends=('ca-certificates')
optdepends=('libsecret: keep the API key in the system keyring (secret-tool)')
provides=('smstunnel-cli')
conflicts=('smstunnel-cli')
options=('!strip' '!debug')
_tag=@TAG@
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/narcisbodea/smstunnel-cli/releases/download/${_tag}/smstunnel-cli_@VERSION@_linux_amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/narcisbodea/smstunnel-cli/releases/download/${_tag}/smstunnel-cli_@VERSION@_linux_arm64.tar.gz")
sha256sums_x86_64=('@SHA256_LINUX_AMD64@')
sha256sums_aarch64=('@SHA256_LINUX_ARM64@')

package() {
  install -Dm755 smstunnel "${pkgdir}/usr/bin/smstunnel"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
