  <metadata>
    <id>smstunnel-cli</id>
    <version>1.0.0</version>
    <packageSourceUrl>https://github.com/narcisbodea/smstunnel-cli/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>narcisbodea</owners>
    <title>SMSTunnel CLI</title>
    <authors>NARBOWEB SRL</authors>
    <projectUrl>https://smstunnel.io</projectUrl>
    <iconUrl>https://smstunnel.io/apple-touch-icon.png</iconUrl>
